# 账户状态文件、目录或逗号分隔的多个路径
AISTUDIO_AUTH_STATES=auth

# 服务监听地址
LISTEN_ADDR=127.0.0.1:2048

# 公开 API 认证密钥：调用 API 必须携带；留空时使用默认密钥 sk-onechat-fun-fun
# 默认密钥随源码公开，对外监听时务必改为自定义密钥
PROXY_API_KEY=sk-onechat-fun-fun

# setup 与未指定账户共同使用的 HTTP、HTTPS 或 SOCKS5 代理
PROXY=

# 单账户初始化超时
INIT_TIMEOUT=2m

# 普通请求最大执行时间
REQUEST_TIMEOUT=5m

# 每次尝试从向上游发送起等待首个上游事件的上限：超时只放弃这一次尝试并换号重试，不能再换号时返回 504
# 0 表示关闭（默认）；思考很长的模型可能很久才有第一个事件，开启时要留足余量，且必须小于 REQUEST_TIMEOUT
FIRST_EVENT_TIMEOUT=0

# 常驻预热账户数（只计普通分区：权益不是 Ultra 的账户）
WARM_WORKER_LIMIT=5

# 高峰期最多同时运行的 Worker 数（只计普通分区；浏览器总数最多为普通与 Ultra 两个分区峰值之和）
MAX_ACTIVE_WORKERS=10

# Ultra 账户独占：true（默认）时权益为 Ultra 的账户只服务 /ultra 前缀的请求（如 http://服务器:端口/ultra/v1），
# 普通路径只用其余账户；false 时普通路径也可以用 Ultra 账户，/ultra 仍只用 Ultra 账户。保存后立即生效
ULTRA_EXCLUSIVE=true

# Ultra 分区的常驻预热 Worker 数，可以为 0（只在请求到来时按需启动）；与普通分区分开计算，保存后立即生效
ULTRA_WARM_WORKER_LIMIT=2

# Ultra 分区高峰期最多同时运行的 Worker 数：至少为 1，且不小于 ULTRA_WARM_WORKER_LIMIT；保存后立即生效
ULTRA_MAX_ACTIVE_WORKERS=5

# 同时冷启动的 Camoufox Worker 数：预热最多占用该数，请求现场的冷启动另保留 1 个名额并优先（WAA_BACKEND=go 不受此限）；
# 普通与 Ultra 两个分区共用
WARM_STARTUP_CONCURRENCY=2

# 单账号同时处理的请求数
PER_ACCOUNT_CONCURRENCY=2

# 账户选择策略：round-robin 或 fill-first
ROUTING_STRATEGY=round-robin

# 生成请求使用的上游通道：playground、build，逗号分隔
UPSTREAM_CHANNELS=playground,build

# 拒绝被上游降级的回复（降级判定）：可在管理页服务配置中修改，立即生效
DOWNGRADE_GUARD=true
# 拦截的模型，逗号分隔（-nothinking、-128 等别名会自动对应）
DOWNGRADE_GUARD_MODELS=gemini-3.1-pro-preview
# 判定为降级的正文速度（tok/s）；正常 Pro 约 90～150，Flash-Lite 约 230～270
DOWNGRADE_SPEED_THRESHOLD=190
# 第一块正文之后新增的正文达到该 token 数、且经过最短窗口（毫秒）后判定
DOWNGRADE_MIN_TOKENS=150
DOWNGRADE_MIN_WINDOW_MS=2500
# Build 通道估算速度落在该区间时调用 CountTokens 精确计算；超时（毫秒）或失败按估算，0 表示不调用
DOWNGRADE_FUZZY_LOW=160
DOWNGRADE_FUZZY_HIGH=220
DOWNGRADE_COUNT_TIMEOUT_MS=1500
# 快速模式：思考实时转发、只缓存正文，被降级时在流中发送错误事件；默认严格模式（判定前不发出任何内容）
DOWNGRADE_FAST_MODE=false
# 流式请求内容的最长延后（毫秒）：0 表示不限（默认：判定前扣住全部内容，被降级时一定返回 400）；设为正数时到时限还没判定就先返回 200 并发出思考
DOWNGRADE_MAX_HOLD_MS=0
# 记住被降级对话的分钟数，0 表示不记录
DOWNGRADE_MEMORY_MINUTES=30
# 因降级拒绝时返回的 HTTP 状态码：400 按 Google 内容策略拦截的格式返回（默认，客户端通常不重试）；
# 503 如实说明上游换用了其他模型，按服务暂时不可用返回（客户端与中转可以重试或切换渠道）
DOWNGRADE_REJECT_STATUS=400

# WAA 后端：camoufox 使用 Camoufox 页面，go 在服务进程内运行
WAA_BACKEND=camoufox

# WAA 预热是否使用临时对话
TEMPORARY_CHAT=false

# 管理进程启动后自动启动生成服务；false 时需在管理页面点击“启动服务”
AUTO_START=true

# 用量账本（runtime/requests.db）同时保存公开 API POST 请求与响应的正文，各截断到 64 KiB，只保留最近 1000 条；
# 正文含提示词与模型输出，以明文保存在本机，默认关闭；修改后重启程序生效（用量统计本身始终记录，保留 90 天）
REQUEST_BODY_LOG=false

# 远程管理密码：设置后可从外网直接打开管理页面（浏览器弹出登录框，用户名随意）；留空时管理页面只允许本机访问
ADMIN_PASSWORD=
