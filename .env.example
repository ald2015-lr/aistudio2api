# 取值无效的项（写法解析不了，或几项组合起来不成立，例如 MAX_ACTIVE_WORKERS 小于 WARM_WORKER_LIMIT）按默认值启动，
# 启动日志逐项写一行“配置项取值无效，已按默认值启动”（凭据类的键不写原值），管理页“服务配置”顶部同样列出
# （管理页不编辑的 REQUEST_BODY_LOG 写错时，在管理页保存其他设置会保留这一行原样，要在本文件里改正）；
# 例外：决定发往 Google 的网络形态、通道、Worker 打开的官网页面与是否自动启动的键取值无效时仍然启动即报错——代理相关的 PROXY、
# PROXY_POOL_* 不会悄悄改成直连，WAA_BACKEND 写错时不会悄悄从纯 Go 改成 Camoufox 浏览器，UPSTREAM_CHANNELS 写错时不会悄悄打开
# Build 通道，TEMPORARY_CHAT 写错（如 yes、on，只认 true/false）时不会悄悄按 false 打开会自动保存历史的普通对话页，
# AUTO_START 写错（如 off、no，只认 true/false）时不会悄悄按 true 自动启动生成服务、预热 Worker 连官网

# 账户状态文件、目录或逗号分隔的多个路径
AISTUDIO_AUTH_STATES=auth

# 服务监听地址
LISTEN_ADDR=127.0.0.1:2048

# 公开 API 认证密钥：调用 API 必须携带；留空时使用默认密钥 sk-onechat-fun-fun
# 默认密钥随源码公开，对外监听时务必改为自定义密钥
PROXY_API_KEY=sk-onechat-fun-fun

# setup 与未指定账户共同使用的代理：http、https 或 socks5，可带账号密码
# 例：PROXY=http://user:pass@1.2.3.4:8080 或 PROXY=1.2.3.4:8080:user:pass（保存时改写成 URL 形式）
# 值里有空格或 # 时整体加双引号
PROXY=

# IP 池（每个浏览器一个 IP）：开启后没有自己代理的账户改用 IP 池出网，不再使用上面的 PROXY；
# 优先级为 账户自己的代理 > IP 池 > PROXY。管理页“服务配置 → IP 池”可修改，保存后立即生效：
# 运行中的 Worker 关闭后才切换，要立即全部切换就停止服务后再启动。
# 模式：off（关闭，默认）、static（静态 IP：端口段里每个端口一个固定 IP，每个运行中的浏览器独占一个端口，
# 账号尽量回到上次用过的端口）、dynamic（动态 IP：地址里的 {session} 按账户换成固定会话号，
# 只含小写字母和数字、最长 15 个字符，一个会话号一个粘性 IP）
PROXY_POOL_MODE=off
# 地址写法同 PROXY，保存时改写成 URL 形式。static 填任意一个端口的地址，端口会被换成下面端口段里的端口，例：
#   PROXY_POOL_URL=http://用户名:密码@isp.decodo.com:10000
# dynamic 在用户名或密码里会话号的位置写 {session}（不区分大小写），例：
#   PROXY_POOL_URL=http://customer-账号-cc-US-sessid-{session}:密码@gate.ipfoxy.io:58688
PROXY_POOL_URL=
# static 的端口段（含两端，最多 5000 个端口）。每台服务器（每个进程）用不重叠的端口段，例如这台 10001-10200、另一台 10201-10400。
# 端口数建议不少于 Σ(峰值 + 排空上限) + 验证并发：排空上限为 min(2×WARM_STARTUP_CONCURRENCY, 峰值/4)（至少 1），
# 例如普通峰值 150、Ultra 峰值 5、WARM_STARTUP_CONCURRENCY=16 时最多 150+32+5+1=188 个浏览器，加验证并发 3 为 191。
# 浏览器多时把进程的打开文件数上限调到 65536 以上（ulimit -n 65536）
PROXY_POOL_PORT_START=10001
PROXY_POOL_PORT_END=10200

# 单账户初始化超时
INIT_TIMEOUT=2m

# 生成请求在首个上游事件之前的总期限：排队、冷启动、WAA proof、附件上传、等首字与首事件前的换号都计入，到时返回 504。
# 开始输出后改为空闲上限：上游连续这么久既没有事件也没有网络字节才以 504 结束；整条生成请求最长 1 小时（本项更长时按本项）。
# 计数、视频与转写等其他请求整段受它限制。修改只影响新请求
REQUEST_TIMEOUT=5m

# 每次尝试从向上游发送起等待首个上游事件的上限：超时只放弃这一次尝试并换号重试，不能再换号时返回 504；
# 客户端还没收到内容时的同账号重新生成每次发送重新起算，本项不到上一次耗时的 1.2 倍时不重新生成
# 0 表示关闭（默认）；思考很长的模型可能很久才有第一个事件，开启时要留足余量，且必须小于 REQUEST_TIMEOUT
FIRST_EVENT_TIMEOUT=0

# 数据型流式心跳：true（默认）时每 10 秒没有输出就写一块空数据（Gemini SSE 为空文本或空思考的候选块，OpenAI Chat 为空 delta 块），
# 首个事件还没到就提交响应头时提交时也写一块（OpenAI Chat 写在 role 块之后，把它顶出落后一块转发的 new-api OpenAI 渠道），
# 代替只写换行（Gemini SSE）或 ": ping"（OpenAI Chat）。new-api 等中转只转发 data 行，在收到第一条 data 之前不给它的客户端写任何字节，
# 开启后中转后面 OpenAI 格式的客户端在等首字、长思考时也能持续收到字节（Claude 格式的客户端经 new-api 时，第一块心跳让 new-api 写出
# message_start，之后的空心跳块被丢弃）；经 new-api 时同时打开它的保持连接心跳（系统设置 → 模型 → 全局模型配置，Ping 间隔 10–15 秒）。
# 开启后 new-api 的首字时间与 TTFT 反映的是本服务写出第一块心跳的时刻，真实首字时间看本服务请求日志的 first_event_ms；new-api 收到
# 第一块心跳就当作已有上游响应，之后客户端断开或流被截断、没有 usageMetadata 时按估算的输入 token 计费（原先只有换行心跳时计 0），
# 介意时关闭它、只依赖 new-api 的 ping。官方 Gemini SDK 直连（x-goog-api-client 带 google-genai-sdk/、genai-py/、genai-js/、gl-python/）
# 时 Gemini SSE 仍只写换行（直连不经过中转，不再多写一种 SDK 判为无效的块；经 new-api 的 Gemini 原生格式中转时照样收到空心跳块）。
# false 时与原先完全一致。JSON 数组模式、Responses、Interactions 与 Anthropic 不受影响。
# 保存后立即生效，只影响新请求
STREAM_DATA_HEARTBEAT=true

# 常驻预热账户数（只计普通分区：不属于 Ultra 号池的账户）。应不小于希望常驻的 Worker 数：
# 超出它的 Worker 空闲 5 分钟后被回收，预热也不会补齐超出部分空出的槽位
WARM_WORKER_LIMIT=5

# 高峰期最多同时运行的 Worker 数（只计普通分区；浏览器总数最多为普通与 Ultra 两个分区峰值之和）。
# 淘汰仍在服务请求的冷却占位时先排空、替补先启动：排空期间分区的浏览器最多再多 min(WARM_STARTUP_CONCURRENCY×2, 峰值/4) 个（至少 1 个）
MAX_ACTIVE_WORKERS=10

# Ultra 号池独占：true（默认）时 Ultra 号池的账户（权益为 Ultra；ULTRA_INCLUDE_PRO=true 时也含权益为 Pro 的账户）
# 只服务 /ultra 前缀的请求（如 http://服务器:端口/ultra/v1），普通路径只用其余账户；false 时普通路径也可以用 Ultra 号池的账户，
# /ultra 仍只用 Ultra 号池的账户。保存后立即生效
ULTRA_EXCLUSIVE=true

# Pro 账户并入 Ultra 号池（付费号池）：true 时权益为 Pro 的账户与 Ultra 账户同属 Ultra 号池，按 Ultra 号池的全部设置调度：
# 经 /ultra 前缀服务并列入 /ultra/v1/models，受上面的 ULTRA_EXCLUSIVE 约束，Worker 计入下面的 ULTRA_WARM_WORKER_LIMIT 与
# ULTRA_MAX_ACTIVE_WORKERS，适用 ULTRA_PRIMARY_MODELS 的快速失败。ULTRA_EXCLUSIVE=true 时 Pro 账户不再服务普通路径：
# gemini-4-argon 与需要订阅权益的模型会从普通路径的 /v1/models 消失（客户端改用 /ultra），普通号池容量变小，
# 普通路径上 Free、Plus 账户输入超过上限后也不能再换到 Pro 账户重试。账户的真实权益不变：权益请求头（TIER1）、输入上限、
# 模型资格、账户页显示的权益与每日额度通道判定仍按 Pro。Pro 与 Ultra 共用两个 ULTRA_* Worker 上限，默认值偏小，开启时应调大；
# ULTRA_WARM_WORKER_LIMIT=1 时唯一常驻的可能是 Pro 账户，建议不小于 2。资源不迁移：开启后（ULTRA_EXCLUSIVE=true 时）经普通路径
# 引用 Pro 账户上已有的文件与视频返回 400，要改用 /ultra；关闭后经 /ultra 引用返回 400，要改用普通路径；ULTRA_EXCLUSIVE=false
# 时开启不会产生 400。默认 false（与升级前行为相同）；保存后立即生效，已运行的 Worker 改按新分区计数，不会重启
ULTRA_INCLUDE_PRO=false

# Ultra 分区的常驻预热 Worker 数，可以为 0（只在请求到来时按需启动）；与普通分区分开计算，保存后立即生效
ULTRA_WARM_WORKER_LIMIT=2

# Ultra 分区高峰期最多同时运行的 Worker 数：至少为 1，且不小于 ULTRA_WARM_WORKER_LIMIT；保存后立即生效
ULTRA_MAX_ACTIVE_WORKERS=5

# 同时冷启动的 Camoufox Worker 数：预热最多占用该数，请求现场的冷启动另保留 1 个名额并优先（WAA_BACKEND=go 不受此限）；
# 普通与 Ultra 两个分区共用
WARM_STARTUP_CONCURRENCY=2

# 单账号同时处理的请求数；受下面的每分钟上限约束，不宜调高
PER_ACCOUNT_CONCURRENCY=2

# 单账号最近 60 秒最多发出的生成请求数（默认 10）：上游每账号每分钟 12 次，所有模型、两个通道共用。
# 满了就算忙碌，请求换到其他账号，热 Worker 都满时启动新的 Worker；只统计本进程，仍保留 429 冷却兜底。
# 0 表示关闭；空值按默认值处理。保存后立即生效
ACCOUNT_RPM_LIMIT=10

# 账户选择策略：round-robin 或 fill-first
ROUTING_STRATEGY=round-robin

# 生成请求使用的上游通道：playground、build，逗号分隔；保存后立即生效。官网停用 Build 通道的生成（PROXY_GENERATION_DISABLED）时
# 不必改它：自动暂停 Build、生成改走 Playground，并定期试探恢复
UPSTREAM_CHANNELS=playground,build

# 流式优先 Playground 的模型，逗号分隔（默认为空：Playground 与 Build 照常轮询）。需要订阅权益的模型在 Build 通道只能
# 一次性返回整段回复；列表中的模型的流式请求先用 Playground 逐块返回，Playground 账号都在忙时立即改用 Build，不等待 Playground。
# 非流式请求不受影响；可在管理页服务配置中修改，立即生效
STREAM_PLAYGROUND_MODELS=

# 主用模型快速失败（普通号池）：列表中的模型（逗号分隔，默认为空）的请求最多等 PRIMARY_QUEUE_WAIT（默认 10s，0 表示不排队，
# 不能超过 REQUEST_TIMEOUT）空闲的账号或 Worker，超过即返回 429 并带 Retry-After，由客户端稍后重试，不再排队到请求超时；留空时所有模型照常排队。
# 上限整个请求共用一份，按实际经过的时间计：换号重试的尝试与退避都算在内，请求自己现场冷启动的浏览器启动时间不计。
# 这份列表只作用于普通路径（不带 /ultra 前缀），/ultra 请求按下面的 ULTRA_PRIMARY_MODELS。
# 同时生成数约为 MAX_ACTIVE_WORKERS × PER_ACCOUNT_CONCURRENCY，每分钟生成次数不超过 Worker 数 × ACCOUNT_RPM_LIMIT；
# 这只是对症状的处理，长期不够用时扩容靠增加 Worker 数；单账号并发受每分钟次数上限约束，不宜调高。
# 可在管理页服务配置中修改，立即生效
PRIMARY_MODELS=
PRIMARY_QUEUE_WAIT=10s

# Ultra 主用模型（默认 gemini-4-argon）：只作用于 /ultra 请求；ULTRA_EXCLUSIVE=false 时，普通路径上不在 PRIMARY_MODELS、
# 但在这份列表里的模型也按这里的规则。排队上限规则与 PRIMARY_QUEUE_WAIT 相同（默认 10s 且不超过 REQUEST_TIMEOUT，0 表示不排队）。
# 这些模型没有额度时立即返回 429 并带 Retry-After，不在服务里一直换号重试：候选账号全部冷却时立即返回；请求中遇到额度 429 后，
# 每日额度用完（以及剩余不少于 15 分钟的冷却）最多再换 2 次账号，分钟限额与限流最多再换 5 次（两类分开计数）；
# 每次额度失败后的那次换号只用已启动的 Worker，不为它现场冷启动备用账号。
# 升级提醒：默认值不为空，升级后 /ultra 上的 gemini-4-argon 自动成为 Ultra 主用模型。关闭时在这里写空值（ULTRA_PRIMARY_MODELS=），
# 或在管理页清空列表；进程环境变量设为空值不生效（空值视为未设置，仍用 .env 里的值或默认值）。可在管理页服务配置中修改，立即生效
ULTRA_PRIMARY_MODELS=gemini-4-argon
ULTRA_PRIMARY_QUEUE_WAIT=10s

# 模型名带 long- 前缀时自动续写（默认 true）：例如 long-gemini-4-argon、long-gemini-4-argon-low，与全部后缀照常组合；
# 不带 long- 的请求完全不续写。输出达到单轮上限后在同一账号上发下一轮，客户端收到一条连续的回复、一份合并后的用量。
# 官网支持自动续写的模型（模型目录能力码 91，如 gemini-4-argon）照官网分轮续写（每轮 32768，总量约 100 万）；其他模型把已输出的正文
# 作为模型消息再发一轮接着写（模拟续写，思考只保留在第一轮，风格可能略有变化）。每轮占一次请求额度、计入 ACCOUNT_RPM_LIMIT，会更慢；
# 只在 Playground 通道进行，Build 与 Interaction（Omni）按普通请求处理。false 时 long- 前缀照常识别，但按普通请求处理。保存后立即生效
LONG_OUTPUT_ENABLED=true

# long- 请求没有给出最大输出时，不支持官网续写的模型最多输出的 token 数（正文与思考合计，默认 262144，约为常见单轮上限 65536 的 4 倍）；
# 0 表示不模拟续写，最大 1048576。轮数约为 总上限 / 模型单轮上限：单轮 65536 的模型最多约 4 轮（多占 3 次请求额度），单轮更小的模型
# 轮数更多（单轮 8192 的模型约 32 轮，一个请求最多 64 轮），每轮占一次请求额度并计入 ACCOUNT_RPM_LIMIT。支持官网续写的模型按官网总量，
# 客户端给出最大输出时以客户端为准。模拟续写把已输出的正文作为输入发回上游，输入上限为 131072 的账号到不了更大的值
# （超过时按 max_tokens 结束）；结构化输出（JSON Schema、JSON 模式）与带联网搜索等 Google 内置工具的请求不模拟续写。保存后立即生效
LONG_OUTPUT_MAX_TOKENS=262144

# 拒绝被上游降级的回复（降级判定）：可在管理页服务配置中修改，立即生效
DOWNGRADE_GUARD=true
# 拦截的模型，逗号分隔（-nothinking、-128 等别名会自动对应）
DOWNGRADE_GUARD_MODELS=gemini-3.1-pro-preview
# 判定为降级的正文速度（tok/s）；正常 Pro 约 90～150，Flash-Lite 约 230～270
DOWNGRADE_SPEED_THRESHOLD=190
# 第一块正文之后新增的正文达到该 token 数、且经过最短窗口（毫秒）后判定
DOWNGRADE_MIN_TOKENS=150
DOWNGRADE_MIN_WINDOW_MS=2500
# Build 通道估算速度落在该区间时调用 CountTokens 精确计算；超时（毫秒）或失败按估算，0 表示不调用
DOWNGRADE_FUZZY_LOW=160
DOWNGRADE_FUZZY_HIGH=220
DOWNGRADE_COUNT_TIMEOUT_MS=1500
# 快速模式：思考实时转发、只缓存正文，被降级时在流中发送错误事件；默认严格模式（判定前不发出任何内容）
DOWNGRADE_FAST_MODE=false
# 流式请求内容的最长延后（毫秒）：0 表示扣到判定出结果或 50 秒为止（默认：判定前扣住全部内容，50 秒内判定为降级时返回 400；
# 到 50 秒还没判定时先返回 200 并写心跳，之后被降级在流内报错）；设为正数时到时限还没判定就先返回 200 并发出思考
DOWNGRADE_MAX_HOLD_MS=0
# 记住被降级对话的分钟数，0 表示不记录
DOWNGRADE_MEMORY_MINUTES=30
# 因降级拒绝时返回的 HTTP 状态码：400 按 Google 内容策略拦截的格式返回（默认，客户端通常不重试）；
# 503 如实说明上游换用了其他模型，按服务暂时不可用返回（客户端与中转可以重试或切换渠道）
DOWNGRADE_REJECT_STATUS=400

# WAA 后端：camoufox 使用 Camoufox 页面，go 在服务进程内运行
WAA_BACKEND=camoufox

# WAA 预热是否使用临时对话（只认 true/false，写错时启动即报错）
TEMPORARY_CHAT=false

# Chat Completions、Messages 与 Gemini 原生接口（generateContent、streamGenerateContent，含 /ultra）回复里生成媒体的输出方式：
# inline 与原先一样内联（data URI / inlineData）；url 按内容保存到 runtime/media/，正文改为本服务 /media/<文件名> 的链接
# （图片 ![image](…)、视频 [video](…)、音频 [audio](…)，Gemini 原生接口另附 fileData）。
# 经 new-api 等中转使用时设为 url：中转把 Gemini 回复转成 OpenAI 格式时会丢掉视频与音频的 inlineData。
# /media/ 不校验 API key，拿到链接的人都能打开；Responses、Interactions、Live 等其他接口不受影响。保存后立即生效
MEDIA_OUTPUT=inline

# 媒体链接使用的服务地址，例如 https://ai.example.com（可带路径前缀，不能带账号密码、查询参数）。
# 经 new-api、nginx 等转发时必须填用户能访问到的公网地址，并让反向代理放行 /media/；
# 留空时按每个请求的 X-Forwarded-Proto、X-Forwarded-Host 或 Host，经中转时多半是用户打不开的内网地址。保存后立即生效
MEDIA_BASE_URL=

# 媒体文件的保存期限（例如 7d、72h），按文件修改时间计算，后台每小时清理一次；0 表示不按时间清理，不为 0 时至少 1 小时
MEDIA_RETENTION=7d

# runtime/media/ 的总量上限（例如 20GB、500MB，按 1024 进位），超过时从最旧的文件开始删除，最近 10 分钟内生成的不删；
# 0 表示不限，不为 0 时至少 100MB。只删除以内容哈希命名的媒体文件，删除后对应链接返回 404
MEDIA_MAX_SIZE=20GB

# 视频模型忽略系统提示：发给能输出视频的 Omni 模型（如 gemini-omni-1.1-flash，含带视频、思考后缀的名称与目录别名）的请求
# 去掉客户端的系统提示（OpenAI 的 system、developer 消息，Responses 的 instructions，Anthropic 的 system 与 messages 里的 system 消息，
# Gemini 的 systemInstruction，Interactions 的 system_instruction），不发给上游，该请求的管理日志记一行去掉的字数（不写原文）。
# 默认开启：Chatbox 等聊天客户端每次都自动加 “You are a helpful assistant.” 一类的系统提示，Omni 带上它时常常只回一段文字、
# 说自己无法生成视频。开启时客户端设置的系统提示（如 Chatbox 的角色设定）对 Omni 不生效，要规定视频风格请写进用户消息；
# 开启前已被拒绝过的对话可能仍只回文字，请新建对话再试。false 时系统提示照常发送，与原先完全一致；这是全局设置，
# 关闭对所有密钥、所有客户端生效。除系统提示外没有其他消息时保留系统提示（按用户消息发送）；
# 文本、图片、Veo、Lyria 等其他模型不受影响。保存后立即生效，只影响新请求
OMNI_IGNORE_SYSTEM_PROMPT=true

# 视频模型带图请求的校验值计入图片：发给 Omni 模型（如 gemini-omni-1.1-flash）、请求里有内联图片（含 GIF 转成的 PNG、
# 移到用户消息的模型历史图片、从本服务链接恢复的图片）时，把这些图片按文字模型带图的同一写法（原数据的 Base64，按它在请求里的位置）
# 计入 WAA 校验值。默认开启：线上带图请求在多个账户上都被官网以 403（没有权限）拒绝、纯文字正常，推断官网算校验值时计入了图片。
# Drive 文件引用（视频等）不计入，纯文字请求与其他模型的校验值不变，请求体不变；false 时只有校验值回到只含文本（与原先相同）。
# 无论开关取值，带图请求被 403 拒绝时都不冷却、不登记账户，最多试 2 个账户后返回 400 说明（可以去掉图片重试）。
# 只认 true/false，写错时按默认值启动并在管理页提示；保存后立即生效，只影响新请求
OMNI_IMAGE_BINDING=true

# 管理进程启动后自动启动生成服务；false 时需在管理页面点击“启动服务”。只认 true/false，写错时启动即报错
AUTO_START=true

# 用量账本（runtime/requests.db）同时保存公开 API POST 请求与响应的正文，各截断到 64 KiB，只保留最近 1000 条；
# 正文含提示词与模型输出，以明文保存在本机，默认关闭；修改后重启程序生效（用量统计本身始终记录，保留 90 天）
REQUEST_BODY_LOG=false

# 远程管理密码：设置后可从外网直接打开管理页面（浏览器弹出登录框，用户名随意）；留空时管理页面只允许本机访问
ADMIN_PASSWORD=

# 守护（./start.sh enable 后 cron 每分钟执行 ./start.sh watchdog）：只由 start.sh 读取，每次检查都重新读，改后即生效。
# 进程不在时自动拉起；进程在但 /health 连续这么多次（每分钟一次，10 秒超时）无响应时判定卡死并重启，0 表示不做卡死检查
# 注意：程序不认识这两项，管理页保存服务配置时会重写 .env 并去掉它们（恢复默认值）。要改的话建议写在 run/watchdog.conf
# （格式同 .env，优先于 .env，程序不会改写它），尤其是关闭卡死检查的 WATCHDOG_HEALTH_FAILS=0
WATCHDOG_HEALTH_FAILS=5
# 进程启动后多少秒内不做卡死判定（预热 Worker 期间），默认 300
WATCHDOG_GRACE=300
# 程序只从进程环境读取、写在这里无效的变量：CAMOUFOX_PATH、SHUTDOWN_GRACE、LANG/LC_ALL/LC_MESSAGES（新加账户的默认语言）、
# TZ、http_proxy/https_proxy 等代理变量。开了守护时 cron 拉起的进程看不到终端 export 的值，请写进 run/watchdog.conf
# （格式同本文件），start.sh 拉起程序时进程环境里没有的从那里补上
